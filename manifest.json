{
  "manifest_version": 3,
  "name": "Folo Reader Optimizer",
  "version": "1.0.0",
  "description": "优化 folo.is 阅读体验：扩展文章列表宽度，点击标题以弹窗阅读正文",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://*.folo.is/*",
        "https://folo.is/*",
        "https://follow.is/*",
        "https://*.follow.is/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}
